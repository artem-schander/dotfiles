#!/usr/bin/env bash
# Block committing credentials. Runs in every repository via core.hooksPath.
#
# Two tiers:
#   always      — credential shapes (keys, tokens, JWTs). Never legitimate.
#   public only — internal hostnames, private IPs, home paths. Only checked when
#                 the origin remote is github.com, where a leak becomes public.
#
# Company-specific hostnames live in secrets.local.patterns, which is gitignored
# so this hook can itself be published without disclosing them.
#
# Bypass a false positive with: git commit --no-verify

RED="$(tput setaf 1 2>/dev/null)"; YELLOW="$(tput setaf 3 2>/dev/null)"
NORMAL="$(tput sgr0 2>/dev/null)"

added=$(git diff --cached -U0 --diff-filter=ACM | grep '^+' | grep -v '^+++')
[ -z "$added" ] && exit 0

CREDENTIALS=(
    "private key block|-----BEGIN [A-Z ]*PRIVATE KEY-----"
    "AWS access key|(AKIA|ASIA)[0-9A-Z]{16}"
    "AWS secret|aws_secret_access_key[[:space:]]*="
    "GitHub token|(gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,})"
    "GitLab token|glpat-[A-Za-z0-9_-]{16,}"
    "Anthropic key|sk-ant-[A-Za-z0-9_-]{20,}"
    "OpenAI-style key|sk-[A-Za-z0-9]{32,}"
    "Slack token|xox[abprs]-[A-Za-z0-9-]{10,}"
    "JWT|eyJ[A-Za-z0-9_-]{16,}\.[A-Za-z0-9_-]{16,}\."
    "Authorization header|[Aa]uthorization:[[:space:]]*(Bearer|Basic)[[:space:]]+[A-Za-z0-9._~+/-]{16,}"
    "assigned secret|(password|passwd|secret|api_?key|access_?token)[[:space:]]*[:=][[:space:]]*[\"'][^\"']{8,}[\"']"
)

PUBLIC_ONLY=(
    "private IP address|(^|[^0-9.])(10\.[0-9]{1,3}|192\.168|172\.(1[6-9]|2[0-9]|3[01]))\.[0-9]{1,3}\.[0-9]{1,3}"
    "home directory path|$HOME/"
)

failures=0
report () {
    printf '%s✗ %s%s\n' "$RED" "$1" "$NORMAL"
    printf '%s\n' "$2" | head -3 | sed 's/^/    /'
    failures=$((failures + 1))
}

# Lines the patterns above match but that hold no secret. Validation rule maps
# are the recurring case: `rules.password = 'required'` assigns a rule name, and
# "required" is exactly the 8 characters the assigned-secret pattern wants. The
# same shape appears in every framework that names rules in strings (Laravel,
# vee-validate), so it would otherwise fire on every form with a password field.
#
# Kept deliberately narrow: only a known rule vocabulary, optionally followed by
# pipe-separated modifiers (required|min:8, nullable|confirmed).
RULE_WORDS="required|nullable|sometimes|confirmed|filled|present|prohibited|accepted|string|numeric"
BENIGN="(password|passwd|secret|api_?key|access_?token)[[:space:]]*[:=][[:space:]]*[\"'](${RULE_WORDS})([|][A-Za-z0-9_:,.*-]+)*[\"']"

# bash 3.2 on macOS has no namerefs, so patterns are passed as arguments
scan () {
    for entry in "$@"; do
        label="${entry%%|*}"
        regex="${entry#*|}"
        hits=$(printf '%s\n' "$added" | grep -inE -e "$regex" 2>/dev/null | grep -vE "$BENIGN")
        [ -n "$hits" ] && report "$label" "$hits"
    done
}

scan "${CREDENTIALS[@]}"

origin=$(git config --get remote.origin.url 2>/dev/null)
if [[ "$origin" == *github.com* ]]; then
    scan "${PUBLIC_ONLY[@]}"
    local_patterns="$HOME/.dotfiles/git/hooks/secrets.local.patterns"
    if [ -f "$local_patterns" ]; then
        while IFS= read -r line; do
            [[ -z "$line" || "$line" == \#* ]] && continue
            hits=$(printf '%s\n' "$added" | grep -inE -e "$line" 2>/dev/null)
            [ -n "$hits" ] && report "internal identifier" "$hits"
        done < "$local_patterns"
    fi
fi

if [ $failures -gt 0 ]; then
    printf '%s\n%s findings above. Remove them, or bypass with: git commit --no-verify%s\n' \
        "$YELLOW" "$failures" "$NORMAL"
    exit 1
fi
exit 0
